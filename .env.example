APP_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=elixo
DB_TEST_NAME=elixo_db
DB_JDBC_URL=
DB_USER=seu_usuario_postgres
DB_PASSWORD=substitua_pela_senha_local

# Preencha quando for usar o Firebase Admin.
# Mantenha o JSON fora do repositório.
# FIREBASE_PROJECT_ID=seu-projeto-firebase
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/Users/SeuUsuario/.secrets/elixo-firebase-admin.json

# URL JDBC usada pelo perfil de produção. Defina no ambiente de implantação.
# DB_JDBC_URL=jdbc:postgresql://servidor:5432/elixo
